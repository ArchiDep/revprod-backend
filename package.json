{
  "name": "revprod-backend",
  "version": "3.1.1",
  "description": "Backend of the website for The Revolutionary Product",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ArchiDep/revprod-backend.git"
  },
  "author": "Simon Oulevay <contact@alphahydrae.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ArchiDep/revprod-backend/issues"
  },
  "homepage": "https://github.com/ArchiDep/revprod-backend#readme",
  "type": "module",
  "scripts": {
    "check": "npm run doctoc && npm run lint && npm run format",
    "check:write": "npm run doctoc:write && npm run lint:write && npm run format:write",
    "clean": "del db.json",
    "dev": "node --watch --env-file-if-exists=.env ./bin.js",
    "doctoc": "doctoc --github --notitle --dryrun README.md",
    "doctoc:write": "doctoc --github --notitle README.md && prettier --write README.md",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint --max-warnings 0",
    "lint:write": "eslint --max-warnings 0 --fix",
    "start": "node ./bin.js",
    "test": "node --test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "http-errors": "^2.0.1",
    "log4js": "^6.9.1",
    "luxon": "^3.7.2",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-pug": "^3.6.0",
    "del-cli": "^8.0.1",
    "doctoc": "^2.5.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": "^26.0.0"
  }
}
